    {
      "name": "13. SQL-инъекция в ID входа",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"' OR 1=1 --\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "14. Регистрация текста SQL-инъекции",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/user/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"first_name\": \"Robert'); DROP TABLE users; --\",\n  \"second_name\": \"O'Reilly\",\n  \"birthdate\": \"1994-05-21\",\n  \"gender\": \"male\",\n  \"biography\": \"Robert'); DROP TABLE users; --\",\n  \"city\": \"Москва\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.environment.set(\"injection_user_id\", pm.response.json().user_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "15. SQL-инъекция сохранилась как текст",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/user/get/{{injection_user_id}}",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"SQL is plain text\", () => { const p = pm.response.json(); pm.expect(p.first_name).to.eql(\"Robert'); DROP TABLE users; --\"); pm.expect(p.biography).to.eql(\"Robert'); DROP TABLE users; --\"); pm.expect(p.second_name).to.eql(\"O'Reilly\"); });",
              "pm.test(\"No password in profile\", () => { const p = pm.response.json(); pm.expect(p).not.to.have.property(\"password\"); pm.expect(p).not.to.have.property(\"password_hash\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "16. Первая анкета по-прежнему доступна",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/user/get/{{user_id}}",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Table intact\", () => pm.expect(pm.response.json().first_name).to.eql(\"Иван\"));"
            ]
          }
        }
      ]
    }
