POSTGRES_DB=social
POSTGRES_USER=social
POSTGRES_PASSWORD=local-development-password
APP_PORT=8080
# Generate your own value: python3 -c 'import secrets; print(secrets.token_hex(32))'
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
TOKEN_TTL_SECONDS=3600
# For running Python directly on the host (Compose sets its own DATABASE_URL).
DATABASE_URL=postgresql://social:local-development-password@localhost:5432/social
